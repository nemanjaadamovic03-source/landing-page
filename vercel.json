{
  "rewrites": [
    { "source": "/", "destination": "/prive-motors/prive-motors.html" },
    { "source": "/(.*)", "destination": "/prive-motors/$1" }
  ],
  "headers": [
    {
      "source": "/prive-motors/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
